  "contract": {
    "kind": "picture-create-from-controls",
    "supported_source": "exact existing CDrawBitmap; one display image in named-reference mode; borrowed source list only",
    "source_archive": "original typed CObList Serialize into owned native CMemFile/CArchive; no synthetic archive bytes",
    "native_vector_load": "C5E9F0→C68410; nested original image scope suppresses auto-register; original Cell rect constructor/clone/owning AddTail",
    "animation": "original worker removes animation only from its private clones and normalizes children into the computed Cell rectangle",
    "contained_reference_restoration": "deep copy expands named image; hash private embedded member must equal the actual existing resource before original C635F0 converts it; name chosen through original setter17",
    "normal_cleanup": "Detached image owns the selection-constructor frames; original PictureAssign/C67670 deep-copies into the new CPicture with coherent archive document context; named-image references are restored only after this copy. CObList node dtor never deletes borrowed source controls. Canonical adoption owns the final tree.",
    "unknown_native_result": "stop; retain ownership/attempt; no guessed cleanup/retry",
    "original_error_branch_may_show_message": "C68410 unsupported-class/error branches are not called intentionally; only guarded real Bitmap source is accepted",
    "host_invoked": false,
    "owner_context": "C68410 root RECT ctor has owner64=0, and cloned child LOAD uses the active document; before raw tree validation use the same original PictureAssign as native gallery callers to deep-copy into a coherent archive context. Never patch owner pointers."
  },
